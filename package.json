{
  "name": "the-big-con-desktop",
  "version": "1.6.0",
  "description": "THE BIG CON — web, desktop (Electron + Discord Rich Presence) and iOS (Capacitor)",
  "main": "main.js",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "postinstall": "node scripts/vendor.js",
    "start": "electron .",
    "dist": "electron-builder",
    "build:web": "node scripts/build-web.js",
    "serve": "npm run build:web && npx --yes serve www -l 8080",
    "ios:add": "npm run build:web && cap add ios",
    "ios:sync": "npm run build:web && cap sync ios",
    "ios:open": "npm run ios:sync && cap open ios",
    "ios:run": "npm run ios:sync && cap run ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@xhayper/discord-rpc": "^1.2.1",
    "peerjs": "1.5.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.thebigcon.desktop",
    "productName": "THE BIG CON",
    "icon": "build/icon",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "platform.js",
      "manifest.webmanifest",
      "favicon.ico",
      "big con logo.png",
      "vendor/**",
      "characters/**",
      "static/**/*.{png,jpg,jpeg,gif,webp,svg}",
      "package.json"
    ],
    "extraResources": [
      { "from": "config.json", "to": "config.json" }
    ],
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "mac": { "icon": "build/icon.icns" },
    "linux": { "icon": "build/icon.png", "target": ["AppImage"] }
  }
}
